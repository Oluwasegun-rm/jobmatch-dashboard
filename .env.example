# Example environment configuration for JobMatch AI Dashboard

# Optional: Comma-separated additional skills to include in the vocabulary
# EXTRA_SKILLS=Snowflake, Looker, Airflow

# Optional: Path to the SQLite database file
# DB_PATH=jobmatch.db

# Optional: CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000

# Frontend: set in frontend/.env.local
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional OpenAI integration
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENABLED=true
